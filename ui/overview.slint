import { StatCard, RateBadge, BarColumn, CategoryRow } from "components.slint";

// Рядок таблиці останніх витрат на головній
component ExpenseRow inherits Rectangle {
    in property <string> title;
    in property <string> category_name;
    in property <color> category_color;
    in property <string> date_str;
    in property <string> orig_amount;
    in property <string> rate_badge: "";
    in property <string> uah_amount;

    height: 38px;

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: #17233f;
    }

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 12px;

        Rectangle {
            width: 250px;
            HorizontalLayout {
                alignment: start;
                Text {
                    text: root.title;
                    color: #ffffff;
                    font-size: 13px;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }

        Rectangle {
            width: 170px;
            HorizontalLayout {
                alignment: start;
                Rectangle {
                    background: root.category_color.transparentize(85%);
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: root.category_color.transparentize(50%);
                    height: 24px;
                    y: (parent.height - self.height) / 2;

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        Text {
                            text: root.category_name;
                            color: root.category_color;
                            font-size: 11px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        Rectangle {
            width: 130px;
            HorizontalLayout {
                alignment: start;
                Text {
                    text: root.date_str;
                    color: #64748b;
                    font-size: 13px;
                    vertical-alignment: center;
                }
            }
        }

        Rectangle {
            width: 180px;
            HorizontalLayout {
                spacing: 8px;
                alignment: start;

                Text {
                    text: root.orig_amount;
                    color: #ffffff;
                    font-size: 13px;
                    font-weight: 600;
                    vertical-alignment: center;
                }

                if root.rate_badge != "" : Rectangle {
                    background: #854d0e.transparentize(70%);
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: #eab308.transparentize(60%);
                    height: 18px;
                    y: (parent.height - self.height) / 2;

                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        Text {
                            text: root.rate_badge;
                            color: #facc15;
                            font-size: 10px;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        Rectangle {
            horizontal-stretch: 1;
            HorizontalLayout {
                alignment: end;
                Text {
                    text: root.uah_amount;
                    color: #f43f5e;
                    font-size: 13px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
            }
        }
    }
}

export component OverviewView inherits VerticalLayout {
